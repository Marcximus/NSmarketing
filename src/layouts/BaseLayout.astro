---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Sidens titel – " | Silberg Creative" tilføjes automatisk (undtagen på forsiden) */
  title: string;
  description?: string;
  /** Sti til delingsbillede i /public */
  ogImage?: string;
  /** 'overlay' = gennemsigtig header over et mørkt hero-billede */
  headerVariant?: 'solid' | 'overlay';
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og-image.jpg',
  headerVariant = 'solid',
  noindex = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  // Andre sider (fx /kontakt/) refererer til organisationen via dette @id
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: `${site.url}/`,
  logo: new URL('/brand/silberg-creative-logo.svg', site.url).href,
  image: ogImageUrl,
  description: site.description,
  telephone: '+45' + site.phone.replace(/\s/g, ''),
  email: site.email,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+45' + site.phone.replace(/\s/g, ''),
    email: site.email,
    areaServed: 'DK',
    availableLanguage: ['Danish'],
  },
  areaServed: { '@type': 'Country', name: 'Danmark' },
  ...(site.address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.zip,
      addressLocality: site.address.city,
      addressCountry: 'DK',
    },
  }),
  ...(site.cvr && { vatID: `DK${site.cvr}` }),
};

// Kun på forsiden: giver sitenavnet i Googles søgeresultater
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: `${site.url}/`,
  inLanguage: 'da-DK',
  publisher: { '@id': `${site.url}/#organization` },
};
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // .js skjuler [data-reveal] til reveal.ts viser dem. Indlæses reveal.ts ikke (fx manglende _astro-fil),
      // vises alt indhold alligevel efter 2,5 sek.
      (function (d) {
        d.classList.add('js');
        setTimeout(function () {
          if (!d.classList.contains('reveal-ready')) d.classList.add('no-reveal');
        }, 2500);
      })(document.documentElement);
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf7f2" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#indhold">Spring til indhold</a>
    <Header variant={headerVariant} />
    <main id="indhold" class:list={[headerVariant === 'overlay' && 'main--overlay']} tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
      import '../scripts/forms';
      import '../scripts/focus-clear';
    </script>
  </body>
</html>

<style is:global>
  /* Ved overlay-header trækkes indholdet op under headeren. Hero-sektionen skal selv lægge
     var(--header-h) ekstra luft i toppen. */
  .main--overlay {
    margin-top: calc(-1 * var(--header-h));
  }

  main:focus {
    outline: none;
  }
</style>
