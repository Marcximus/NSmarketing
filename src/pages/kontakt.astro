---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactMain from '../components/kontakt/ContactMain.astro';
import CallbackBand from '../components/kontakt/CallbackBand.astro';
import ContactFaq from '../components/kontakt/ContactFaq.astro';
import { site } from '../data/site';

const description = `Book et uforpligtende møde om jeres sociale medier. Ring på ${site.phone}, skriv til ${site.email} eller udfyld formularen – vi svarer inden for én hverdag.`;

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Kontakt ${site.name}`,
  url: new URL('/kontakt/', site.url).href,
  description,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: site.name,
    url: site.url,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: '+45' + site.phone.replace(/\s/g, ''),
      email: site.email,
      areaServed: 'DK',
      availableLanguage: ['Danish'],
    },
  },
};

const reassurance = ['Uforpligtende første møde', 'Fast kontaktperson', 'Én fast pris om måneden'];
---

<BaseLayout title="Kontakt" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(contactJsonLd)} />

  <PageHero
    eyebrow="Kontakt"
    title="Lad os tage en <em>snak</em>"
    lead="Book et uforpligtende møde om jeres sociale medier. Skriv et par linjer eller ring direkte – vi vender tilbage inden for én hverdag."
  >
    <div class="hero-actions">
      <div class="btn-row hero-actions__buttons">
        <a href={site.phoneHref} class="btn"><Icon name="phone" size={16} /> Ring {site.phone}</a>
        <a href="#ring-op" class="btn btn--outline">Bliv ringet op</a>
      </div>
      <ul class="hero-actions__facts" role="list">
        {reassurance.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </PageHero>

  <ContactMain />
  <CallbackBand />
  <ContactFaq />
</BaseLayout>

<style>
  .hero-actions {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    width: 100%;
  }

  .hero-actions__buttons {
    justify-content: center;
  }

  .hero-actions__facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-2);
  }

  .hero-actions__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .hero-actions__facts li::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--c-gold);
    transform: rotate(45deg);
  }

  @media (max-width: 479px) {
    .hero-actions__buttons {
      width: 100%;
    }

    .hero-actions__buttons .btn {
      flex: 1 1 100%;
    }

    .hero-actions__facts {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
