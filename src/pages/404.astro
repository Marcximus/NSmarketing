---
// 404 – vises, når en side ikke findes.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, mainNav } from '../data/site';

const packagesLink = mainNav.find((item) => item.href.startsWith('/pakkeloesninger'))?.href ?? '/pakkeloesninger/';
const contactLink = mainNav.find((item) => item.href.startsWith('/kontakt'))?.href ?? '/kontakt/';
---

<BaseLayout
  title="Siden blev ikke fundet"
  description={`Siden findes ikke. Gå til forsiden, se vores pakkeløsninger, eller kontakt ${site.name} på ${site.phone}.`}
  noindex
>
  <section class="nf">
    <div class="nf__marble" aria-hidden="true"></div>
    <div class="container nf__inner">
      <p class="eyebrow eyebrow--center" data-reveal>Fejl 404</p>

      <p class="nf__code" aria-hidden="true" data-reveal style="--reveal-delay: .06s">
        4<em>0</em>4
      </p>

      <h1 data-reveal style="--reveal-delay: .12s">Siden findes <em>ikke</em></h1>

      <p class="lead nf__lead" data-reveal style="--reveal-delay: .18s">
        Siden, du leder efter, er flyttet, har skiftet navn eller har aldrig eksisteret. Herfra kommer du hurtigt
        videre.
      </p>

      <div class="btn-row nf__actions" data-reveal style="--reveal-delay: .24s">
        <a href="/" class="btn">Til forsiden <Icon name="arrow" size={16} /></a>
        <a href={packagesLink} class="btn btn--outline">Se pakkeløsninger</a>
        <a href={contactLink} class="btn btn--outline">Kontakt os</a>
      </div>

      <p class="nf__help small" data-reveal style="--reveal-delay: .3s">
        Leder du efter noget bestemt? Ring på
        <a href={site.phoneHref} class="nowrap">{site.phone}</a>
        eller skriv til <a href={site.emailHref}>{site.email}</a> – så hjælper vi dig videre.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(4rem, 3rem + 5vw, 7.5rem);
    border-bottom: 1px solid var(--c-line);
    text-align: center;
  }

  .nf__marble {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(ellipse at center, rgba(250, 247, 242, 0.9) 0%, rgba(250, 247, 242, 0.55) 70%),
      url('../assets/images/marble.jpg');
    background-size: cover;
    background-position: center;
  }

  /* Tynd guldramme inde i marmorfladen */
  .nf__marble::after {
    content: '';
    position: absolute;
    inset: clamp(0.75rem, 0.25rem + 1.5vw, 1.75rem);
    border: 1px solid var(--c-gold);
    opacity: 0.55;
    pointer-events: none;
  }

  .nf__inner {
    max-width: calc(46rem + var(--gutter) * 2);
    /* Ekstra luft, så indholdet ikke rører guldrammen på små skærme */
    padding-inline: calc(var(--gutter) + clamp(0.75rem, 0.25rem + 1.5vw, 1.75rem));
  }

  .nf__code {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    font-family: var(--f-serif);
    font-size: clamp(6rem, 3.5rem + 13vw, 12.5rem);
    font-weight: 400;
    font-variant-numeric: lining-nums;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--c-ink);
  }

  .nf__code em {
    font-style: italic;
    color: var(--c-gold-ink);
  }

  .nf h1 {
    font-size: var(--fs-h2);
  }

  .nf__lead {
    max-width: 34rem;
    margin: var(--space-5) auto 0;
  }

  .nf__actions {
    justify-content: center;
    margin-top: var(--space-7);
  }

  .nf__help {
    max-width: 30rem;
    margin: var(--space-7) auto 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-sand);
    color: var(--c-ink-2);
  }

  .nf__help a {
    color: var(--c-ink);
    text-decoration-color: var(--c-gold);
    overflow-wrap: anywhere;
  }

  .nf__help a:hover {
    color: var(--c-gold-ink);
  }

  @media (max-width: 539px) {
    .nf__actions .btn {
      width: 100%;
    }
  }
</style>
