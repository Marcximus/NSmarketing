---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number | string;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, strokeWidth = 1.4, class: className, label } = Astro.props;
const isFilled = name === 'facebook' || name === 'tiktok';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={isFilled ? 1.3 : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
