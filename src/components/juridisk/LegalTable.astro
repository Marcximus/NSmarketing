---
// Overskuelig tabel til juridiske sider. På mobil stables hver række som et kort med kolonnenavne.
// Celler må indeholde simpel HTML (fx <strong> og links).
interface Props {
  caption: string;
  columns: string[];
  rows: string[][];
  /** Relativ bredde på første kolonne på større skærme */
  firstCol?: string;
}

const { caption, columns, rows, firstCol = '38%' } = Astro.props;
---

<div class="legal-block ltable" style={`--first-col: ${firstCol}`}>
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        {columns.map((c) => <th scope="col">{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) =>
              i === 0 ? (
                <th scope="row" data-label={columns[i]} set:html={cell} />
              ) : (
                <td data-label={columns[i]} set:html={cell} />
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ltable {
    border-top: 1px solid var(--c-ink);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  tr {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--c-line);
  }

  th,
  td {
    display: block;
    padding: 0;
    text-align: left;
    vertical-align: top;
  }

  tbody th {
    font-family: var(--f-serif);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--c-ink);
  }

  td {
    color: var(--c-ink-2);
  }

  td::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  td :global(strong) {
    font-weight: 500;
    color: var(--c-ink);
  }

  td :global(a) {
    color: var(--c-ink);
    text-decoration-color: var(--c-gold);
  }

  @media (min-width: 720px) {
    thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    table {
      display: table;
      table-layout: fixed;
    }

    tr {
      display: table-row;
      padding: 0;
    }

    th,
    td {
      display: table-cell;
      padding: 1.15rem 1.5rem 1.15rem 0;
      border-bottom: 1px solid var(--c-line);
    }

    th:last-child,
    td:last-child {
      padding-right: 0;
    }

    thead th {
      padding-block: 0.9rem;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--c-gold-ink);
    }

    thead th:first-child {
      width: var(--first-col);
    }

    tbody th {
      font-size: 1.0625rem;
    }

    td::before {
      display: none;
    }
  }
</style>
