---
// Afsluttende CTA-bånd (mørkebrunt) med booking og telefon. Ingen kicker; titlen skrives uden <em>.
// Props:
// - title / text: overskrift og lead.
// - image: billede i højre kolonne (default cta.jpg). Hver side bør have sit eget billede, så båndet ikke
//   gentager sig fra side til side. null giver et kompakt tekstbånd uden billede.
// - imageAlt: alt-tekst til billedet.
// - imagePosition: object-position til beskæringen, fx 'center 30%'.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import ctaImage from '../assets/images/cta.jpg';

interface Props {
  title?: string;
  text?: string;
  image?: ImageMetadata | null;
  imageAlt?: string;
  imagePosition?: string;
}

const {
  title = 'Klar til sociale medier, der arbejder for jer?',
  text = 'På et kort møde kigger vi på jeres nuværende profiler og fortæller, hvad vi ville gøre – og hvilken pakke der giver mening for jer.',
  image = ctaImage,
  imageAlt = 'Content creator filmer indhold til sociale medier',
  imagePosition = 'center',
} = Astro.props;
---

<section class:list={['cta-band section section--brown', !image && 'cta-band--compact']}>
  <div class="container cta-band__grid">
    <div class="cta-band__content">
      <h2 set:html={title} />
      <p class="lead">{text}</p>
      <div class="btn-row">
        <a href="/kontakt/" class="btn btn--gold">Book et uforpligtende møde <Icon name="arrow" size={16} /></a>
        <a href={site.phoneHref} class="btn btn--outline-light"><Icon name="phone" size={16} /> Ring {site.phone}</a>
      </div>
      <p class="cta-band__note small">Vi svarer inden for én hverdag.</p>
    </div>
    {
      image && (
        <div class="cta-band__media">
          <div class="media">
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 720, 960]}
              sizes="(min-width: 900px) 40vw, 90vw"
              style={`object-position: ${imagePosition}`}
            />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .cta-band__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .cta-band__grid > * {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .cta-band__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 6vw, 7rem);
    }
  }

  .cta-band__content .lead {
    max-width: 34rem;
    margin-block: var(--space-5) var(--space-6);
  }

  .cta-band__note {
    margin-top: var(--space-4);
    color: var(--c-cream-muted);
  }

  .cta-band__media .media {
    aspect-ratio: 4 / 5;
    max-height: 560px;
    margin-left: auto;
    outline: 1px solid rgb(var(--c-gold-light-rgb) / 0.45);
    outline-offset: 14px;
  }

  @media (max-width: 899px) {
    .cta-band__media .media {
      aspect-ratio: 16 / 10;
      outline-offset: 10px;
    }
  }

  /* Kompakt tekstbånd uden billede (image={null}) */
  .cta-band--compact {
    padding-block: calc(var(--section-y) * 0.7);
  }

  .cta-band--compact .cta-band__grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .cta-band--compact .cta-band__content {
    max-width: 44rem;
  }
</style>
