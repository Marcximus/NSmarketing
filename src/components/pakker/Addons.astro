---
// Tillægsydelser (src/data/addons.ts). Alle kategorier er synlige – også uden JS.
// Hver kategori er en prisliste (menukort): navn og beskrivelse til venstre, pris og "Spørg os" til højre.
// Hvert tillæg har id'et tillaeg-<id>, som forsiden og sammenligningstabellen linker til.
// Desktop: sticky kategori-menu i venstre side. Mobil/tablet: sticky vandret menu under headeren.
import Icon from '../Icon.astro';
import { addonCategories, addonNote } from '../../data/addons';
import { site } from '../../data/site';
---

<section class="section addons" id="tillaeg" aria-labelledby="tillaeg-titel">
  <div class="container">
    <div class="addons__head">
      <h2 id="tillaeg-titel">Byg jeres pakke større med tillægsydelser</h2>
      <p class="lead">
        Alle tillæg kan lægges oven i enhver pakke – fast hver måned eller kun i de perioder, hvor I har brug for
        ekstra kræfter. Fra <a href="#tillaeg-statister">statister</a> og
        <a href="#tillaeg-content-dag">ekstra content-dage</a> til <a href="#tillaeg-seo">SEO</a> og
        <a href="#tillaeg-email">e-mailmarketing</a>.
      </p>
    </div>

    <div class="addons__layout">
      <nav class="addons__nav" aria-label="Kategorier af tillægsydelser" data-addon-nav>
        <p class="addons__nav-title" aria-hidden="true">Kategorier</p>
        <ol role="list">
          {
            addonCategories.map((c) => (
              <li>
                <a href={`#tillaeg-${c.id}`} data-addon-link={c.id}>
                  <span class="addons__nav-text">{c.title}</span>
                  <span class="addons__nav-count">
                    {c.items.length}
                    <span class="visually-hidden"> ydelser</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>

        <div class="addons__help">
          <p class="addons__help-title">Usikre på, hvad I har brug for?</p>
          <p class="addons__help-text">Vi sammensætter gerne en løsning, der passer til jeres mål og budget.</p>
          <a href={site.phoneHref} class="addons__help-link">
            <Icon name="phone" size={15} /> Ring {site.phone}
          </a>
          <a href={site.emailHref} class="addons__help-link">
            <Icon name="mail" size={15} /> Skriv til os
          </a>
        </div>
      </nav>

      <div class="addons__cats">
        {
          addonCategories.map((c) => (
            <section
              class="addon-cat"
              id={`tillaeg-${c.id}`}
              aria-labelledby={`tillaeg-kat-${c.id}`}
              data-addon-cat={c.id}
            >
              <header class="addon-cat__head">
                <h3 id={`tillaeg-kat-${c.id}`}>{c.title}</h3>
                <p>{c.intro}</p>
              </header>

              <ul class="menu" role="list">
                {c.items.map((a) => (
                  <li class="menu__row" id={`tillaeg-${a.id}`}>
                    <div class="menu__main">
                      <h4 class="menu__name">{a.name}</h4>
                      <p class="menu__desc">{a.description}</p>
                    </div>
                    <div class="menu__side">
                      <p class:list={['menu__price', !a.price && 'menu__price--quote']}>
                        {a.price ?? 'Pris efter aftale'} {a.unit && <span class="menu__unit">{a.unit}</span>}
                      </p>
                      <a href={`/kontakt/?emne=${a.id}`} class="menu__ask">
                        Spørg os<span class="visually-hidden"> om {a.name}</span> <Icon name="arrow" size={14} />
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }

        <p class="addons__custom">
          Står det, I har brug for, ikke på listen? <a href="/kontakt/?emne=tillaeg">Fortæl os om opgaven</a> – så
          sammensætter vi en løsning.
        </p>
        <p class="addons__note">{addonNote}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Markerer den kategori, man er ved at læse, i kategori-menuen
  const nav = document.querySelector<HTMLElement>('[data-addon-nav]');
  const list = nav?.querySelector<HTMLElement>('ol');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-addon-link]')];
  const cats = [...document.querySelectorAll<HTMLElement>('[data-addon-cat]')];

  if (nav && list && links.length && cats.length && 'IntersectionObserver' in window) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Hold et punkt helt synligt i den vandrette mobilmenu
    const keepVisible = (link: HTMLAnchorElement, behavior: ScrollBehavior) => {
      if (list.scrollWidth <= list.clientWidth) return;
      const left = link.offsetLeft - list.offsetLeft;
      const outside = left < list.scrollLeft || left + link.offsetWidth > list.scrollLeft + list.clientWidth;
      if (outside) list.scrollTo({ left: Math.max(0, left - 16), behavior });
    };

    const setActive = (id: string) => {
      links.forEach((link) => {
        if (link.dataset.addonLink === id) {
          link.setAttribute('aria-current', 'true');
          keepVisible(link, reduceMotion.matches ? 'auto' : 'smooth');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    // Tastaturfokus: browseren scroller kun menuen, hvis punktet er helt skjult – vis hele punktet
    links.forEach((link) => link.addEventListener('focus', () => keepVisible(link, 'auto')));

    const visible = new Map<string, boolean>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set((e.target as HTMLElement).dataset.addonCat ?? '', e.isIntersecting));
        const current = cats.find((c) => visible.get(c.dataset.addonCat ?? ''));
        if (current?.dataset.addonCat) setActive(current.dataset.addonCat);
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    cats.forEach((c) => observer.observe(c));
  }
</script>

<style>
  /* ---------- Overskrift ---------- */
  .addons__head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  @media (min-width: 960px) {
    .addons__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: end;
    }
  }

  /* Genvejene til de mest efterspurgte tillæg står som links i lead'en */
  .addons__head .lead a {
    color: var(--c-ink);
    text-decoration-color: var(--c-gold);
    text-underline-offset: 0.3em;
    transition: color var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .addons__head .lead a:hover {
      color: var(--c-gold-ink);
    }
  }

  /* ---------- Layout ---------- */
  .addons__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .addons__layout {
      grid-template-columns: 15.5rem minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5.5rem);
      align-items: start;
    }
  }

  /* ---------- Kategori-menu ---------- */
  .addons__nav {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
  }

  .addons__nav ol {
    list-style: none;
  }

  .addons__nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--c-ink-2);
    transition: color var(--dur) var(--ease);
  }

  .addons__nav a:hover,
  .addons__nav a[aria-current='true'] {
    color: var(--c-ink);
  }

  .addons__nav-count {
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--c-muted);
  }

  /* Mobil/tablet: vandret menu, der klæber under headeren */
  @media (max-width: 1023px) {
    .addons__nav {
      margin-inline: calc(-1 * var(--gutter));
      background: rgb(var(--c-paper-rgb) / 0.97);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-block: 1px solid var(--c-line);
    }

    .addons__nav-title,
    .addons__help,
    .addons__nav-count {
      display: none;
    }

    /* Tynd scrollbar viser, at strimlen kan scrolles */
    .addons__nav ol {
      display: flex;
      overflow-x: auto;
      scrollbar-width: thin;
      padding-inline: calc(var(--gutter) - 0.9rem);
      scroll-padding-inline: var(--gutter);
    }

    .addons__nav li {
      flex-shrink: 0;
    }

    .addons__nav a {
      position: relative;
      gap: 0.5rem;
      min-height: 3.25rem;
      padding-inline: 0.9rem;
      font-size: var(--fs-sm);
      white-space: nowrap;
      color: var(--c-muted);
    }

    .addons__nav a::after {
      content: '';
      position: absolute;
      left: 0.9rem;
      right: 0.9rem;
      bottom: -1px;
      height: 0;
      border-bottom: 2px solid var(--c-gold);
      transform: scaleX(0);
      transition: transform var(--dur) var(--ease);
    }

    .addons__nav a[aria-current='true']::after {
      transform: scaleX(1);
    }

    /* Den vandrette menu klipper alt uden for <ol> (overflow-x) – fokusringen lægges indenfor */
    .addons__nav a:focus-visible {
      outline-offset: -4px;
    }

    /* Rækker og fokuserede links må ikke gemme sig bag den klæbende kategorimenu (ca. 3.4rem under headeren) */
    .menu__row,
    .menu__ask,
    .addons__custom a {
      scroll-margin-top: calc(var(--header-h) + 4.5rem);
    }
  }

  /* Desktop: lodret menu i venstre side */
  @media (min-width: 1024px) {
    .addons__nav {
      top: calc(var(--header-h) + 2rem);
    }

    .addons__nav-title {
      padding-bottom: 0.9rem;
      font-size: var(--fs-xs);
      font-weight: 500;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--c-muted);
      border-bottom: 1px solid var(--c-line);
    }

    .addons__nav li {
      border-bottom: 1px solid var(--c-line);
    }

    .addons__nav a {
      position: relative;
      padding: 0.9rem 0;
      font-size: 0.9375rem;
      line-height: 1.35;
      transition:
        color var(--dur) var(--ease),
        padding var(--dur) var(--ease);
    }

    .addons__nav a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 0;
      height: 0;
      border-top: 1px solid var(--c-gold);
      transition: width var(--dur) var(--ease);
    }

    .addons__nav a[aria-current='true'] {
      padding-left: 1.75rem;
    }

    .addons__nav a[aria-current='true']::before {
      width: 1.1rem;
    }

    .addons__nav-text {
      flex: 1;
    }

    .addons__help {
      margin-top: 2rem;
      padding: 1.5rem;
      border: 1px solid var(--c-line);
      background: var(--c-white);
    }

    .addons__help-title {
      font-family: var(--f-serif);
      font-size: var(--fs-md);
      line-height: 1.3;
    }

    .addons__help-text {
      margin: 0.6rem 0 0.9rem;
      font-size: var(--fs-sm);
      line-height: 1.55;
      color: var(--c-ink-2);
    }

    .addons__help-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      font-size: var(--fs-sm);
      font-weight: 500;
      text-decoration: none;
      color: var(--c-ink);
      border-top: 1px solid var(--c-line);
    }

    .addons__help-link :global(svg) {
      color: var(--c-gold);
    }

    .addons__help-link:hover {
      color: var(--c-gold-ink);
    }
  }

  /* ---------- Kategorier ---------- */
  .addon-cat {
    scroll-margin-top: calc(var(--header-h) + 4.5rem);
  }

  @media (min-width: 1024px) {
    .addon-cat {
      scroll-margin-top: calc(var(--header-h) + 2rem);
    }
  }

  .addon-cat + .addon-cat {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .addon-cat__head {
    margin-bottom: 1.5rem;
  }

  .addon-cat__head h3 {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
  }

  .addon-cat__head p {
    max-width: var(--measure);
    margin-top: 0.5rem;
    color: var(--c-ink-2);
  }

  /* ---------- Prisliste (menukort) ---------- */
  .menu {
    list-style: none;
  }

  .menu__row {
    display: grid;
    gap: 0.85rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--c-line);
  }

  .menu__row:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  /* Rækken, et link har ført til (fx "Statister & modeller" fra forsiden) – en svag beige tone,
     der fylder lidt ud over kanten uden at flytte layoutet */
  .menu__row:target {
    --row-tint: rgb(var(--c-beige-rgb) / 0.7);

    background: var(--row-tint);
    box-shadow:
      -1rem 0 0 var(--row-tint),
      1rem 0 0 var(--row-tint);
  }

  @media (min-width: 720px) {
    .menu__row {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 2.5rem;
      align-items: baseline;
    }
  }

  @media (min-width: 1024px) {
    .menu__row {
      scroll-margin-top: calc(var(--header-h) + 2rem);
    }
  }

  .menu__name {
    font-family: var(--f-serif);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .menu__desc {
    max-width: var(--measure);
    margin-top: 0.4rem;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--c-ink-2);
  }

  /* Mobil: pris til venstre og "Spørg os" til højre på samme linje (flugter med prisens grundlinje) */
  .menu__side {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  /* Desktop: højrestillet kolonne med pris, enhed og "Spørg os" under hinanden */
  @media (min-width: 720px) {
    .menu__side {
      display: grid;
      justify-items: end;
      gap: 0.4rem;
      max-width: 14rem;
      text-align: right;
    }
  }

  .menu__price {
    font-family: var(--f-serif);
    font-size: 1.25rem;
    line-height: 1.25;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    color: var(--c-ink);
  }

  .menu__price--quote {
    color: var(--c-muted);
  }

  .menu__unit,
  .menu__ask {
    font-family: var(--f-sans);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .menu__unit {
    display: block;
    margin-top: 0.3rem;
    white-space: normal;
    color: var(--c-muted);
  }

  .menu__ask {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
    text-decoration: none;
    color: var(--c-ink);
    transition: color var(--dur) var(--ease);
  }

  .menu__ask :global(svg) {
    flex-shrink: 0;
    color: var(--c-gold);
    transition: transform var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .menu__ask:hover {
      color: var(--c-gold-ink);
    }

    .menu__ask:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  @media (pointer: coarse) {
    .menu__ask {
      min-height: 44px;
    }
  }

  .addons__custom,
  .addons__note {
    margin-top: 2rem;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .addons__custom {
    color: var(--c-ink-2);
  }

  .addons__custom + .addons__note {
    margin-top: 0.5rem;
  }

  .addons__custom a {
    font-weight: 500;
    color: var(--c-ink);
    text-decoration-color: var(--c-gold);
    text-underline-offset: 0.3em;
  }

  .addons__custom a:hover {
    color: var(--c-gold-ink);
  }
</style>
