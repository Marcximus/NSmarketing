---
// De tre pakkekort øverst på pakkesiden. Alt indhold kommer fra src/data/packages.ts.
// Rækkerne i kortene flugter på desktop (CSS subgrid), så navne, priser, nøgletal og knapper står på linje.
import Icon from '../Icon.astro';
import { packages, pricingNote, formatPrice } from '../../data/packages';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section plans-section" id="pakker" aria-labelledby="pakker-titel">
  <div class="container">
    <h2 id="pakker-titel" class="visually-hidden">Vælg jeres pakke</h2>

    <div class="plans">
      {
        packages.map((p, i) => (
          <article
            class:list={['plan', `plan--${p.id}`, p.featured && 'plan--featured on-dark']}
            aria-labelledby={`plan-${p.id}`}
            data-reveal
            style={`--reveal-delay: ${i * 0.08}s`}
          >
            <div class="plan__top">
              <span class="plan__index" aria-hidden="true">
                {pad(i + 1)}
              </span>
              {p.badge && <span class="plan__badge">{p.badge}</span>}
            </div>

            <header class="plan__head">
              <h3 class="plan__name" id={`plan-${p.id}`}>
                {p.name}
              </h3>
              <p class="plan__tagline">{p.tagline}</p>
            </header>

            <p class="plan__ideal">{p.idealFor}</p>

            <div class="plan__price">
              <p class="plan__price-line">
                <span class="plan__amount">{formatPrice(p.price)}</span>
                <span class="plan__unit">kr./md.</span>
              </p>
              <p class="plan__vat">ekskl. moms</p>
            </div>

            <dl class="plan__summary">
              {p.summary.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>

            {/* Ét direkte barn, så kortet stadig har præcis 7 rækker i subgrid'et */}
            <div class="plan__list">
              {p.plusLabel && <p class="plan__plus">{p.plusLabel}</p>}
              <ul class="check-list">
                {p.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>

            <div class="plan__actions">
              <a
                href={`/kontakt/?pakke=${p.id}`}
                class:list={['btn', 'btn--block', p.featured ? 'btn--gold' : 'btn--outline']}
              >
                Vælg {p.name} <Icon name="arrow" size={16} />
              </a>
              <a href="#sammenlign" class="plan__more" data-show-plan={p.id}>
                Se alt indhold<span class="visually-hidden"> i {p.name}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="plans__note" data-reveal>{pricingNote}</p>
  </div>
</section>

<style>
  .plans-section {
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  /* Desktop: kortene rejser sig op over herosektionens marmor, så priserne ses i første skærmbillede.
     Overlappet er PageHero's bundpadding minus 2rem, så der altid er 2rem luft mellem lead og kort. */
  @media (min-width: 1000px) {
    .plans-section {
      position: relative;
      z-index: 1;
      margin-top: calc(2rem - clamp(3.5rem, 2.5rem + 4vw, 6rem));
      padding-top: 0;
    }
  }

  /* ---------- Grid ---------- */
  .plans {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  @media (min-width: 1000px) {
    .plans {
      max-width: none;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(7, auto);
      column-gap: clamp(1rem, 1.6vw, 1.75rem);
      row-gap: 0;
    }

    /* .plans > .plan: skal vinde over grundreglen .plan { display: flex } længere nede */
    .plans > .plan {
      grid-row: span 7;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }

  /* ---------- Kort ---------- */
  .plan {
    --plan-pad: clamp(1.75rem, 1.2rem + 1.4vw, 2.6rem);
    --plan-tier: var(--c-sand);
    --plan-line: var(--c-line);
    --plan-muted: var(--c-muted);

    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--plan-pad);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    box-shadow: inset 0 2px 0 var(--plan-tier);
  }

  .plan--gold {
    --plan-tier: var(--c-gold);
  }

  .plan--black {
    --plan-tier: var(--c-ink);
  }

  .plan--featured {
    --plan-line: color-mix(in srgb, var(--c-cream) 16%, transparent);
    --plan-muted: var(--c-cream-muted);

    background: var(--c-brown);
    border-color: var(--c-brown);
    color: var(--c-cream);
  }

  /* Top: nummer + badge */
  .plan__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 1.9rem;
    margin-bottom: 1.5rem; /* holder første pris inden for første skærmbillede ved 1440×900 */
  }

  .plan__index {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    color: var(--plan-muted);
  }

  .plan__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: var(--c-gold-light);
    color: var(--c-brown-deep);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Navn */
  .plan__name {
    font-size: clamp(2.4rem, 1.9rem + 1.3vw, 3.1rem);
    line-height: 1;
  }

  .plan__tagline {
    margin-top: 0.85rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  .plan--featured .plan__tagline {
    color: var(--c-gold-light);
  }

  .plan__ideal {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-ink-2);
  }

  .plan--featured .plan__ideal {
    color: var(--c-cream-muted);
  }

  /* Pris */
  .plan__price {
    margin-top: 1.9rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--plan-line);
  }

  .plan__price-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .plan__amount {
    font-family: var(--f-serif);
    font-variant-numeric: lining-nums;
    font-size: clamp(2.6rem, 2.1rem + 1.2vw, 3.3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .plan__unit {
    font-size: var(--fs-base);
    color: var(--c-ink-2);
  }

  .plan--featured .plan__unit {
    color: var(--c-cream);
  }

  .plan__vat {
    margin-top: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--plan-muted);
  }

  /* Tre nøgletal */
  .plan__summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1.75rem 0 0;
    border-block: 1px solid var(--plan-line);
  }

  .plan__summary > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.45rem;
    padding: 1.1rem 0.15rem;
    text-align: center;
  }

  .plan__summary > div + div {
    border-left: 1px solid var(--plan-line);
  }

  .plan__summary dd {
    margin: 0;
    font-family: var(--f-serif);
    font-variant-numeric: lining-nums;
    font-size: 1.85rem;
    line-height: 1;
  }

  .plan__summary dt {
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--plan-muted);
  }

  /* Highlights */
  .plan__list {
    margin-top: 1.75rem;
  }

  .plan .plan__list ul {
    gap: 0.8rem;
    font-size: 0.9375rem;
  }

  /* "Alt i Silver, plus:" – gør forskellen mellem pakkerne let at skimme */
  .plan__plus {
    margin-bottom: 0.9rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--plan-muted);
  }

  .plan--featured .plan__list li::before {
    border-color: var(--c-gold-light);
  }

  /* Knapper */
  .plan__actions {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: 2.25rem;
    padding-top: 0;
  }

  /* align-self: end krymper elementet i Chromes subgrid – derfor align-content i stedet */
  @media (min-width: 1000px) {
    .plan__actions {
      align-content: end;
    }
  }

  .plan__actions .btn {
    width: 100%;
  }

  .plan:not(.plan--featured) .btn--outline {
    --btn-border: var(--c-ink);
  }

  .plan__more {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    text-decoration: underline;
    text-decoration-color: var(--c-sand);
    text-underline-offset: 0.35em;
    transition:
      color var(--dur) var(--ease),
      text-decoration-color var(--dur) var(--ease);
  }

  .plan__more:hover {
    color: var(--c-gold-ink);
    text-decoration-color: currentColor;
  }

  .plan--featured .plan__more {
    color: var(--c-cream-muted);
    text-decoration-color: color-mix(in srgb, var(--c-cream) 35%, transparent);
  }

  .plan--featured .plan__more:hover {
    color: var(--c-gold-light);
  }

  /* Mobil: lidt strammere lodret rytme i de stablede kort, så første pris ses uden at scrolle */
  @media (max-width: 699px) {
    .plan__top {
      margin-bottom: 1.25rem;
    }

    .plan__price {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
    }

    .plan__summary {
      margin-top: 1.5rem;
    }

    .plan__list {
      margin-top: 1.5rem;
    }

    .plan__actions {
      margin-top: 1.75rem;
    }
  }

  /* Tablet: kortet deles i to kolonner, så siden ikke bliver uendeligt lang */
  @media (min-width: 700px) and (max-width: 999px) {
    .plans {
      max-width: 46rem;
    }

    .plan {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'top top'
        'head summary'
        'ideal list'
        'price list'
        'actions list';
      grid-template-rows: auto auto auto auto 1fr;
      column-gap: clamp(2rem, 5vw, 3rem);
    }

    .plan__top {
      grid-area: top;
    }

    .plan__head {
      grid-area: head;
    }

    .plan__ideal {
      grid-area: ideal;
    }

    .plan__price {
      grid-area: price;
    }

    .plan__summary {
      grid-area: summary;
      align-self: start;
      margin-top: 0;
    }

    .plan__list {
      grid-area: list;
      align-content: start;
    }

    .plan__actions {
      grid-area: actions;
      align-content: end;
    }
  }

  .plans__note {
    max-width: 44rem;
    margin: clamp(2rem, 1.5rem + 1.5vw, 3rem) auto 0;
    font-size: var(--fs-sm);
    text-align: center;
    color: var(--c-muted);
  }
</style>
