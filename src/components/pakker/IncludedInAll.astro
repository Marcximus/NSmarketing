---
// "Alle pakker inkluderer" – fælles standard på tværs af pakkerne (src/data/packages.ts → includedInAll).
import Icon from '../Icon.astro';
import { packages, includedInAll } from '../../data/packages';

const names = packages.map((p) => p.name);
const nameList = names.length > 1 ? `${names.slice(0, -1).join(', ')} eller ${names.at(-1)}` : names[0];
---

<section class="section section--tight incl" aria-labelledby="incl-titel">
  <div class="incl__bg" aria-hidden="true"></div>
  <div class="container incl__grid">
    <div class="incl__head" data-reveal>
      <p class="eyebrow">I alle pakker</p>
      <h2 id="incl-titel">Det får I <em>altid</em> med</h2>
      <p class="lead">
        Uanset om I vælger {nameList}, arbejder I med det samme team, de samme processer og den samme standard.
      </p>
    </div>

    <ul class="incl__list" role="list">
      {
        includedInAll.map((item, i) => (
          <li data-reveal style={`--reveal-delay: ${0.05 + i * 0.05}s`}>
            <span class="incl__icon" aria-hidden="true">
              <Icon name="check" size={16} strokeWidth={1.8} />
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .incl {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-block: 1px solid var(--c-line);
  }

  .incl__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--c-beige);
    background-image:
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--c-beige) 96%, transparent) 0%,
        color-mix(in srgb, var(--c-beige) 88%, transparent) 45%,
        color-mix(in srgb, var(--c-beige) 72%, transparent) 100%
      ),
      url('../../assets/images/marble.jpg');
    background-size: cover;
    background-position: center 65%;
  }

  .incl__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 960px) {
    .incl__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }

  .incl__head h2 {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.9rem);
  }

  .incl__head .lead {
    max-width: 30rem;
    margin-top: var(--space-5);
  }

  .incl__list {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--c-sand);
  }

  @media (min-width: 640px) {
    .incl__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 2.75rem);
    }
  }

  .incl__list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--c-sand);
    line-height: 1.5;
  }

  .incl__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    margin-top: -0.15rem;
    border: 1px solid var(--c-gold);
    color: var(--c-gold-ink);
    background: color-mix(in srgb, var(--c-white) 55%, transparent);
  }
</style>
