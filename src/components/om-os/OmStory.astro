---
// Historie og mission: billedkollage i guldramme, tekst, mission og servicegarantier.
// Bevidst neutral formulering – ingen navne eller årstal, før de er bekræftet.
import { Image } from 'astro:assets';
import studioImage from '../../assets/images/studio.jpg';
import detailImage from '../../assets/images/creator-hands.jpg';
import { promises } from '../../data/content';
---

<section class="section story" id="historie" aria-labelledby="story-title">
  <div class="container">
    <div class="story__grid">
      <div class="story__media" data-reveal>
        <div class="frame-gold story__frame">
          <div class="media story__main">
            <Image
              src={studioImage}
              alt="Moodboard med materialeprøver i marmor, træ, hør og guld"
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 42vw, 92vw"
            />
          </div>
        </div>
        <div class="media story__detail" data-reveal style="--reveal-delay: .18s">
          <Image
            src={detailImage}
            alt="Hænder holder et analogt kamera klar til at tage et billede"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 17vw, 38vw"
          />
        </div>
      </div>

      <div class="story__content" data-reveal style="--reveal-delay: .08s">
        <p class="eyebrow">Vores historie</p>
        <h2 id="story-title">Sociale medier, der er lige så <em>gennemførte</em> som jeres forretning</h2>
        <div class="story__text">
          <p class="lead">
            Silberg Creative blev grundlagt med en enkel ambition: at give danske virksomheder et udtryk på
            de sociale medier, der matcher kvaliteten af det, de laver – og som skaber målbare resultater.
          </p>
          <p>
            Alt for mange dygtige virksomheder bruger aftener og weekender på at finde på opslag, der
            hverken ligner dem eller skaber nye kunder. Derfor samler vi strategi, content, annoncering og
            rapportering ét sted – hos ét fast team, der tager ansvar for det hele.
          </p>
          <p>
            Vi kombinerer et skarpt, æstetisk blik med en datadrevet tilgang. Hvert opslag har et formål,
            hver måned bliver målt, og hver anbefaling bygger på jeres tal.
          </p>
        </div>

        <figure class="story__mission">
          <p class="story__mission-label">Vores mission</p>
          <blockquote>
            <p>
              At gøre jeres sociale medier til en af jeres <em>stærkeste</em> salgskanaler – uden at det
              koster jer tid.
            </p>
          </blockquote>
        </figure>
      </div>
    </div>

    <div class="story__facts" data-reveal>
      <p class="story__facts-label">Det kan I regne med</p>
      <dl class="story__facts-list">
        {
          promises.map((p) => (
            <div class="fact">
              <dt class="fact__label">{p.label}</dt>
              <dd class="fact__value">{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .story__grid {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .story__grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: clamp(4rem, 8vw, 8rem);
    }
  }

  /* ---------- Billedkollage ---------- */
  .story__media {
    position: relative;
    padding: 0 1.25rem 3.5rem 0;
  }

  .story__main {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 1024px) {
    .story__media {
      padding-bottom: 5rem;
    }

    .story__main {
      aspect-ratio: 4 / 5;
    }
  }

  .story__detail {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 38%;
    aspect-ratio: 4 / 5;
    outline: 10px solid var(--c-paper);
  }

  @media (min-width: 1024px) {
    .story__detail {
      right: -1.5rem;
      width: 40%;
      outline-width: 12px;
    }
  }

  /* ---------- Tekst ---------- */
  .story__content h2 {
    max-width: 17ch;
  }

  .story__text {
    margin-top: var(--space-6);
  }

  .story__text > * + * {
    margin-top: var(--space-4);
  }

  .story__text p:not(.lead) {
    color: var(--c-ink-2);
  }

  .story__mission {
    margin-top: var(--space-7);
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--c-line);
  }

  .story__mission-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  .story__mission blockquote {
    position: relative;
    margin: var(--space-4) 0 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--c-gold);
  }

  .story__mission blockquote p {
    font-family: var(--f-serif);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.4;
    color: var(--c-ink);
  }

  .story__mission em {
    color: var(--c-gold-ink);
  }

  /* ---------- Servicegarantier ---------- */
  .story__facts {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-line);
  }

  @media (min-width: 1024px) {
    .story__facts {
      grid-template-columns: 14rem 1fr;
      gap: var(--space-7);
      align-items: start;
    }
  }

  .story__facts-label {
    padding-top: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  .story__facts-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  @media (min-width: 720px) {
    .story__facts-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: var(--space-4) var(--space-4) var(--space-5) 0;
  }

  @media (min-width: 720px) {
    .fact {
      padding: 0 var(--space-5);
      border-left: 1px solid var(--c-line);
    }

    .fact:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 719px) {
    .fact:nth-child(even) {
      padding-left: var(--space-5);
      border-left: 1px solid var(--c-line);
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--c-line);
    }
  }

  .fact__value {
    margin: 0;
    font-family: var(--f-serif);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem);
    line-height: 1;
    color: var(--c-ink);
  }

  .fact__label {
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--c-muted);
  }
</style>
