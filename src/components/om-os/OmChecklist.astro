---
// "Slip for besværet – vi klarer det hele": tjekliste over det, kunden får, på mørkebrun baggrund.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import feedImage from '../../assets/images/phone-feed.jpg';

const items = [
  'SoMe-strategi og månedlig contentplan',
  'Content-dage med fotograf og videograf',
  'Opslag, karruseller, reels og stories',
  'Professionel redigering af foto og video',
  'Tekster og hashtags, der lyder som jer',
  'Grafik i jeres visuelle identitet',
  'Udgivelse på de rigtige tidspunkter',
  'Svar på kommentarer og beskeder',
  'Annoncering på Meta og TikTok',
  'Månedlig rapport med konkrete anbefalinger',
];
---

<section class="section section--deep checklist" aria-labelledby="checklist-title">
  <div class="checklist__marble" aria-hidden="true"></div>
  <div class="container checklist__grid">
    <div class="checklist__content" data-reveal style="--reveal-delay: .08s">
      <p class="eyebrow">Det får I</p>
      <h2 id="checklist-title">Slip for besværet – vi <em>klarer</em> det hele</h2>
      <p class="lead">
        Fra den første idé til den månedlige rapport. Vi tager os af hele processen, så I kan bruge tiden på
        jeres kunder og jeres forretning.
      </p>

      <ul class="checklist__list" role="list">
        {items.map((item) => <li>{item}</li>)}
      </ul>

      <p class="checklist__note small">Det præcise omfang afhænger af jeres pakke og eventuelle tillæg.</p>

      <div class="btn-row">
        <a href="/pakkeloesninger/" class="btn btn--gold">Se pakkeløsninger <Icon name="arrow" size={16} /></a>
        <a href="/pakkeloesninger/#tillaeg" class="btn btn--outline-light">Se tillægsydelser</a>
      </div>
    </div>

    <div class="checklist__media" data-reveal>
      <div class="media">
        <Image
          src={feedImage}
          alt="Hånd holder en telefon med et Instagram-feed i et lyst, beige interiør"
          widths={[400, 600, 800, 1000]}
          sizes="(min-width: 1024px) 36vw, 92vw"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .checklist {
    --checklist-line: color-mix(in srgb, var(--c-cream) 14%, transparent);

    overflow: hidden;
    isolation: isolate;
  }

  .checklist__marble {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('../../assets/images/marble.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.06;
    mix-blend-mode: screen;
  }

  .checklist__grid {
    display: grid;
    gap: clamp(3.5rem, 7vw, 5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .checklist__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(4rem, 8vw, 8rem);
    }

    .checklist__media {
      grid-column: 1;
      grid-row: 1;
    }

    .checklist__content {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .checklist__content h2 {
    max-width: 14ch;
  }

  .checklist__content .lead {
    max-width: 36rem;
    margin-top: var(--space-5);
  }

  .checklist__list {
    display: grid;
    margin-top: var(--space-7);
    list-style: none;
    border-top: 1px solid var(--checklist-line);
  }

  @media (min-width: 640px) {
    .checklist__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  .checklist__list li {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.7rem 0 0.7rem 2.1rem;
    border-bottom: 1px solid var(--checklist-line);
    line-height: 1.45;
    color: var(--c-cream);
  }

  .checklist__list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 50%;
    width: 0.95rem;
    height: 0.5rem;
    border-left: 1.5px solid var(--c-gold-light);
    border-bottom: 1.5px solid var(--c-gold-light);
    transform: translateY(-70%) rotate(-45deg);
  }

  .checklist__note {
    margin-block: var(--space-5) var(--space-6);
    color: var(--c-cream-muted);
  }

  .checklist__media .media {
    aspect-ratio: 4 / 3;
    outline: 1px solid color-mix(in srgb, var(--c-gold-light) 45%, transparent);
    outline-offset: 12px;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .checklist__media .media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1024px) {
    .checklist__media .media {
      aspect-ratio: 4 / 5;
      outline-offset: 16px;
    }
  }
</style>
