---
// Ledige stillinger (vises kun, når `openings` i ./careerRoles.ts har indhold) + "Bliv en del af vores netværk" med roller.
// Tilføj kun rigtige stillinger – opfind ikke opslag.
import Icon from '../Icon.astro';
import { careerRoles, openings } from './careerRoles';

const applyHref = (value: string) => `/karriere/?rolle=${encodeURIComponent(value)}#ansoeg`;
const hasOpenings = openings.length > 0;
---

{
  hasOpenings && (
    <section class="section openings" id="stillinger" aria-labelledby="openings-title">
      <div class="container openings__grid">
        <div class="openings__head" data-reveal>
          <p class="eyebrow">Ledige stillinger</p>
          <h2 id="openings-title">Åbne <em>stillinger</em></h2>
          <p class="openings__lead">
            Se vores aktuelle opslag herunder – eller send os en uopfordret ansøgning, hvis du ikke finder den
            rette rolle.
          </p>
        </div>

        <div class="board" data-reveal style="--reveal-delay: .08s">
          <div class="board__head" aria-hidden="true">
            <span>Stilling</span>
            <span>Type</span>
            <span>Sted</span>
            <span />
          </div>
          <ul class="board__list" role="list">
            {openings.map((o) => (
              <li class="board__row">
                <h3 class="board__role">{o.title}</h3>
                <p class="board__meta">
                  <span class="visually-hidden">Type: </span>
                  {o.type}
                </p>
                <p class="board__meta">
                  <span class="visually-hidden">Sted: </span>
                  {o.location}
                </p>
                <a href={applyHref(o.title)} class="text-link board__link">
                  Ansøg<span class="visually-hidden">: {o.title}</span>
                  <Icon name="arrow" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

<section class="section section--white kroles" id="netvaerk" aria-labelledby="kroles-title">
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div>
        <p class="eyebrow">{hasOpenings ? 'Freelance & samarbejde' : 'Vi rekrutterer løbende'}</p>
        <h2 id="kroles-title">Bliv en del af vores <em>netværk</em></h2>
      </div>
      <p class="lead">
        Vi samarbejder løbende med freelancere og kreative talenter, når vores kunder har brug for ekstra
        kompetencer. Find din rolle, og send os en ansøgning.
      </p>
    </div>

    <ul class="kroles__grid" role="list">
      {
        careerRoles.map((role, i) => (
          <li class="krole" data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
            <span class="krole__icon" aria-hidden="true">
              <Icon name={role.icon} size={22} />
            </span>
            <h3 class="krole__title">{role.title}</h3>
            <p class="krole__text">{role.text}</p>
            <a href={applyHref(role.value)} class="text-link krole__link">
              Ansøg<span class="visually-hidden">: {role.title}</span>
              <Icon name="arrow" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---------- Ledige stillinger ---------- */
  .openings__grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .openings__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(4rem, 8vw, 7rem);
      align-items: start;
    }
  }

  .openings__grid > * {
    min-width: 0;
  }

  .openings__lead {
    margin-top: var(--space-5);
    max-width: 26rem;
    color: var(--c-ink-2);
  }

  .board {
    border: 1px solid var(--c-line);
    background: var(--c-white);
  }

  .board__head {
    display: none;
  }

  .board__list {
    list-style: none;
  }

  .board__row {
    display: grid;
    gap: 0.35rem var(--space-4);
    padding: var(--space-5) clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
    border-bottom: 1px solid var(--c-line);
  }

  .board__row:last-child {
    border-bottom: 0;
  }

  .board__role {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
  }

  .board__meta {
    font-size: 0.95rem;
    color: var(--c-ink-2);
  }

  .board__link {
    justify-self: start;
  }

  @media (min-width: 640px) {
    .board__head,
    .board__row {
      grid-template-columns: 2fr 1fr 1fr auto;
      align-items: center;
    }

    .board__head {
      display: grid;
      gap: var(--space-4);
      padding: 1rem clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
      border-bottom: 1px solid var(--c-line);
      background: var(--c-paper);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--c-muted);
    }
  }

  /* ---------- Roller ---------- */
  .kroles__grid {
    display: grid;
    gap: 1px;
    list-style: none;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }

  @media (min-width: 640px) {
    .kroles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .kroles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .krole {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    background: var(--c-white);
    transition: background-color var(--dur) var(--ease);
  }

  .krole:hover {
    background: var(--c-paper);
  }

  .krole__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    border: 1px solid var(--c-gold);
    background: var(--c-paper);
    color: var(--c-gold-ink);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .krole:hover .krole__icon {
    background: var(--c-brown-deep);
    color: var(--c-gold-light);
  }

  .krole__title {
    font-size: clamp(1.35rem, 1.2rem + 0.4vw, 1.6rem);
  }

  .krole__text {
    margin-top: var(--space-3);
    max-width: 26rem;
    font-size: 0.975rem;
    color: var(--c-ink-2);
  }

  .krole__text {
    margin-bottom: var(--space-5);
  }

  .krole__link {
    margin-top: auto;
  }
</style>
