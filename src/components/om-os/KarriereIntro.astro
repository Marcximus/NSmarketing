---
// Karriere: hvad det vil sige at arbejde med os + hvad vi værdsætter.
import { Image } from 'astro:assets';
import handsImage from '../../assets/images/creator-hands.jpg';

const expectations = [
  'Varierede opgaver for virksomheder i mange forskellige brancher',
  'Klare briefs, så du ved præcis, hvad opgaven går ud på',
  'Et kreativt miljø med høje standarder og plads til idéer',
  'Indhold i høj kvalitet, du kan være stolt af at vise frem',
];

const values: { title: string; text: string }[] = [
  {
    title: 'Sans for æstetik',
    text: 'Du har et skarpt øje for detaljer, lys og komposition – og ved, at kvaliteten ligger i det, de fleste overser.',
  },
  {
    title: 'Ansvar og ordentlighed',
    text: 'Du holder, hvad du lover. Vores kunder skal kunne regne med os, og det starter hos hver enkelt af os.',
  },
  {
    title: 'Nysgerrighed',
    text: 'Platforme, formater og trends ændrer sig hele tiden. Du er på forkant – og deler gerne det, du lærer.',
  },
  {
    title: 'Holdånd',
    text: 'Vi lykkes sammen. Du giver og modtager gerne sparring og glæder dig over andres gode idéer.',
  },
];
---

<section class="section kintro" aria-labelledby="kintro-title">
  <div class="container kintro__grid">
    <div class="kintro__content">
      <h2 id="kintro-title">Kreativt håndværk med høje standarder</h2>
      <p class="lead">
        Vi skaber indhold til virksomheder, der går op i, hvordan de fremstår – og vi går lige så meget op i
        det selv. Strateger, fotografer, content creators og grafikere arbejder tæt sammen om hver eneste
        kunde.
      </p>
      <h3 class="kintro__subhead">Det kan du forvente</h3>
      <ul class="check-list kintro__list">
        {expectations.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="kintro__media">
      <div class="frame-gold">
        <div class="media kintro__image">
          <Image
            src={handsImage}
            alt="Hænder holder et analogt kamera klar til at tage et billede"
            widths={[400, 600, 800, 1000]}
            sizes="(min-width: 1024px) 38vw, 92vw"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section--beige kvalues" aria-labelledby="kvalues-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <h2 id="kvalues-title">Det værdsætter vi</h2>
      </div>
      <p class="lead">
        Erfaring og et stærkt portfolio betyder meget. Men det er måden, du arbejder på, der gør forskellen –
        for os og for vores kunder.
      </p>
    </div>

    <ul class="ruled-list ruled-list--2 kvalues__list" role="list">
      {
        values.map((value) => (
          <li>
            <h3 class="ruled-list__title">{value.title}</h3>
            <p class="ruled-list__text">{value.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---------- Intro ---------- */
  .kintro__grid {
    display: grid;
    gap: clamp(3.5rem, 7vw, 5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .kintro__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(4rem, 8vw, 8rem);
    }
  }

  .kintro__content h2 {
    max-width: 14ch;
  }

  .kintro__content .lead {
    max-width: 38rem;
    margin-top: var(--space-5);
  }

  .kintro__subhead {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-line);
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  .kintro__list {
    margin-top: var(--space-5);
    color: var(--c-ink-2);
  }

  @media (min-width: 640px) {
    .kintro__list {
      grid-template-columns: 1fr 1fr;
      gap: 1rem 2.25rem;
    }
  }

  .kintro__media {
    padding: 0 1.25rem 1.25rem 0;
  }

  .kintro__image {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 1024px) {
    .kintro__image {
      aspect-ratio: 4 / 5;
    }
  }
</style>
