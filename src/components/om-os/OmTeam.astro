---
// Teamet bag Silberg Creative som redaktionel masthead + netværket af specialister.
// Founder-kortet står på mørkebrun marmor; de øvrige roller er en liste med hårstreger.
// Personer uden navn vises med rollen som titel. Når der står et navn i src/data/team.ts, vises navnet
// som titel og rollen som undertitel.
import Icon from '../Icon.astro';
import Monogram from '../../assets/monogram-s.svg';
import { team, network } from '../../data/team';

const leadMember = team.find((m) => m.lead);
const members = team.filter((m) => m !== leadMember);
---

<section class="section section--white team" id="team" aria-labelledby="team-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <h2 id="team-title">Et team af specialister</h2>
      </div>
      <p class="lead">
        Bag hver profil, vi håndterer, står et team med hver sit speciale. Strategi, content og annoncering
        hænger sammen – fordi de mennesker, der skaber det, arbejder tæt sammen.
      </p>
    </div>

    <div class="team__layout">
      {
        leadMember && (
          <div class="member--lead on-dark">
            <div class="marble marble--dark" aria-hidden="true" />
            <Monogram class="member__monogram" aria-hidden="true" focusable="false" />
            <div class="member__body">
              <h3 class="member__title">{leadMember.name ?? leadMember.role}</h3>
              {leadMember.name && <p class="member__sub">{leadMember.role}</p>}
              <p class="member__text">{leadMember.description}</p>
              <a href="/kontakt/" class="text-link member__link">
                Book et møde med os <Icon name="arrow" size={16} />
              </a>
            </div>
          </div>
        )
      }

      <ul class="ruled-list team__roles" role="list">
        {
          members.map((member) => (
            <li>
              <h3 class="ruled-list__title">{member.name ?? member.role}</h3>
              {member.name && <p class="member__sub">{member.role}</p>}
              <p class="ruled-list__text">{member.description}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="network" id="netvaerk">
      <div class="network__intro">
        <h3 class="network__title">Specialister, når I har brug for dem</h3>
        <p class="network__text">
          Vi tilknytter specialister efter behov, så I altid får de rette kompetencer – uden at betale for
          dem, når I ikke har brug for dem.
        </p>
      </div>
      <div class="network__side">
        <ul class="network__list" role="list">
          {network.map((item) => <li>{item}</li>)}
        </ul>
        <a href="/karriere/" class="text-link network__link">
          Bliv en del af netværket <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Masthead: founder-kort + roller ---------- */
  .team__layout {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .team__layout > * {
    min-width: 0;
  }

  @media (min-width: 960px) {
    .team__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: stretch;
    }
  }

  .team__roles .ruled-list__title {
    font-size: clamp(1.375rem, 1.25rem + 0.3vw, 1.5rem);
  }

  .member__sub {
    margin-top: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  /* ---------- Founder-kort ---------- */
  .member--lead {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 26rem;
    padding: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    background: var(--c-brown-deep);
    color: var(--c-cream);
  }

  .member--lead :global(.member__monogram) {
    position: absolute;
    z-index: -1;
    top: clamp(1.75rem, 1rem + 2vw, 3rem);
    right: clamp(1.5rem, 0.5rem + 3vw, 3.5rem);
    width: auto;
    height: clamp(8rem, 4rem + 13vw, 18rem);
    color: var(--c-gold);
    opacity: 0.4;
  }

  .member__body {
    max-width: 34rem;
  }

  .member--lead .member__title {
    font-size: clamp(2rem, 1.4rem + 1.8vw, 2.9rem);
    line-height: var(--lh-tight);
  }

  .member--lead .member__sub {
    color: var(--c-gold-light);
  }

  .member--lead .member__text {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--fs-md);
    font-weight: 300;
    color: var(--c-cream-muted);
  }

  .member__link {
    margin-top: var(--space-6);
  }

  /* ---------- Netværk ---------- */
  .network {
    display: grid;
    gap: var(--space-6);
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    border: 1px solid var(--c-line);
    background: var(--c-paper);
  }

  @media (min-width: 960px) {
    .network {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }

  .network__title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    line-height: var(--lh-tight);
  }

  .network__text {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--c-ink-2);
  }

  .network__list {
    display: grid;
    grid-template-columns: 1fr;
    list-style: none;
    border-top: 1px solid var(--c-sand);
  }

  @media (min-width: 480px) {
    .network__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  .network__list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.5rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--c-sand);
    font-family: var(--f-serif);
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .network__list li::before {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    background: var(--c-gold);
    transform: rotate(45deg);
  }

  .network__link {
    margin-top: var(--space-5);
  }

  @media (forced-colors: active) {
    .network__list li::before {
      background: none;
      border: 1px solid CanvasText;
    }
  }
</style>
