---
// Kort arbejdsproces som tidslinje i fire trin + henvisning til pakkerne.
import Icon from '../Icon.astro';
import { process } from '../../data/content';
---

<section class="section omprocess" aria-labelledby="omprocess-title">
  <div class="omprocess__bg" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div>
        <p class="eyebrow">Sådan arbejder vi</p>
        <h2 id="omprocess-title">Et samarbejde i <em>fire</em> klare trin</h2>
      </div>
      <p class="lead">
        En fast og gennemskuelig proces, så I altid ved, hvad der sker – og hvornår. I godkender, vi leverer.
      </p>
    </div>

    <ol class="timeline" role="list">
      {
        process.map((step, i) => (
          <li class="timeline__step" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
            <span class="timeline__marker" aria-hidden="true">
              {step.number}
            </span>
            <h3 class="timeline__title">
              <span class="visually-hidden">Trin {i + 1}: </span>
              {step.title}
            </h3>
            <p class="timeline__text">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="omprocess__cta" data-reveal>
      <p>Klar til at se, hvad det koster?</p>
      <div class="omprocess__links">
        <a href="/pakkeloesninger/" class="btn btn--outline">Se pakkeløsninger <Icon name="arrow" size={16} /></a>
        <a href="/kontakt/" class="text-link">Book en uforpligtende samtale <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .omprocess {
    overflow: hidden;
    isolation: isolate;
  }

  .omprocess__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--c-paper) 70%, transparent) 0%,
        color-mix(in srgb, var(--c-paper) 88%, transparent) 100%
      ),
      url('../../assets/images/marble.jpg');
    background-size: cover;
    background-position: center 60%;
  }

  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-6);
    list-style: none;
  }

  /* Mobil: lodret tidslinje */
  .timeline__step {
    position: relative;
    padding-left: 4.5rem;
  }

  .timeline__step::before {
    content: '';
    position: absolute;
    left: 1.5rem;
    top: 3rem;
    bottom: calc(-1 * var(--space-6));
    width: 1px;
    background: var(--c-sand);
  }

  .timeline__step:last-child::before {
    display: none;
  }

  .timeline__marker {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--c-gold);
    background: var(--c-white);
    font-family: var(--f-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--c-gold-ink);
  }

  .timeline__title {
    padding-top: 0.55rem;
    font-size: clamp(1.3rem, 1.15rem + 0.4vw, 1.5rem);
  }

  .timeline__text {
    margin-top: var(--space-3);
    max-width: 24rem;
    font-size: 0.975rem;
    color: var(--c-ink-2);
  }

  /* Tablet: to kolonner */
  @media (min-width: 720px) {
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7) var(--space-6);
    }

    .timeline__step::before {
      display: none;
    }
  }

  /* Desktop: vandret tidslinje */
  @media (min-width: 1100px) {
    .timeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .timeline::before {
      content: '';
      position: absolute;
      top: 1.5rem;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--c-sand);
    }

    .timeline__step {
      padding-left: 0;
    }

    .timeline__marker {
      position: relative;
      margin-bottom: var(--space-6);
    }

    .timeline__title {
      padding-top: 0;
    }
  }

  .omprocess__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-6);
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-sand);
  }

  .omprocess__cta > p {
    font-family: var(--f-serif);
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--c-ink);
  }

  .omprocess__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
</style>
