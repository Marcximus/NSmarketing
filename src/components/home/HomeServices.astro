---
// De fire kerneydelser i et skarpt grid med hårstreger + udvalgte tillægsydelser (linker til kortene på pakkesiden).
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { services } from '../../data/content';
import { addonCategories } from '../../data/addons';

// Udvalgte tillæg, som vises som "Og når I vil mere"
const featuredAddonIds = ['statister', 'email', 'seo', 'influencer', 'video', 'meta-ads'];
const allAddons = addonCategories.flatMap((c) => c.items);
const featuredAddons = featuredAddonIds
  .map((id) => allAddons.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// Blød bindestreg i lange sammensatte ord ("Influencer-/marketing"), så de kan brydes i de smalle mobilkolonner
const breakable = (name: string) => name.replace(/(\p{Ll})(marketing)/gu, '$1\u00AD$2');
---

<section class="section section--white services">
  <div class="container">
    <SectionHead
      eyebrow="Det tager vi os af"
      title="Alt, hvad jeres sociale medier <em>kræver</em>"
      lead="Fire discipliner, ét samlet team og én fast pris om måneden. Vi tager ansvaret for hele processen – fra den første strategi til den månedlige rapport."
      align="split"
    />

    <ul class="services__grid">
      {
        services.map((s, i) => (
          <li class="service" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <div class="service__top">
              <span class="service__num" aria-hidden="true">
                {s.number}
              </span>
              <Icon name={s.icon} size={30} strokeWidth={1.2} />
            </div>
            <h3 class="service__title">{s.title}</h3>
            <p class="service__text">{s.text}</p>
            <span class="service__rule" aria-hidden="true" />
          </li>
        ))
      }
    </ul>

    <div class="services__addons" data-reveal>
      <p class="services__addons-label">Og når I vil mere</p>
      <ul>
        {featuredAddons.map((a) => (
          <li>
            <a href={`/pakkeloesninger/#tillaeg-${a.id}`}>{breakable(a.name)}</a>
          </li>
        ))}
      </ul>
      <a href="/pakkeloesninger/#tillaeg" class="text-link">Alle tillægsydelser <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  /* Hårstreger: 1px mellemrum på stregfarvet baggrund */
  .services__grid {
    display: grid;
    gap: 1px;
    list-style: none;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }

  @media (min-width: 720px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .services__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    background: var(--c-white);
    transition: background-color var(--dur) var(--ease);
  }

  .service:hover {
    background: var(--c-paper);
  }

  .service__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    color: var(--c-gold);
  }

  .service__num {
    font-family: var(--f-serif);
    font-variant-numeric: lining-nums;
    font-size: 1.05rem;
    font-style: italic;
    color: var(--c-gold-ink);
  }

  .service__title {
    font-size: clamp(1.4rem, 1.2rem + 0.5vw, 1.6rem);
  }

  .service__text {
    margin-top: var(--space-4);
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--c-ink-2);
  }

  .service__rule {
    display: block;
    width: 2rem;
    height: 1px;
    margin-top: auto;
    padding-top: 0;
    background: var(--c-gold);
    transform-origin: left;
    transition: width var(--dur) var(--ease);
  }

  .service__text {
    margin-bottom: var(--space-6);
  }

  .service:hover .service__rule {
    width: 4rem;
  }

  /* Tillæg */
  .services__addons {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  @media (min-width: 1024px) {
    .services__addons {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2.5rem;
      margin-top: 2.25rem;
    }
  }

  .services__addons-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  .services__addons ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.5rem;
    list-style: none;
  }

  @media (min-width: 720px) {
    .services__addons ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.75rem; /* linkene er selv 44 px høje */
    }
  }

  .services__addons li {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--f-serif);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--c-ink);
  }

  .services__addons li a {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    overflow-wrap: anywhere;
    color: inherit;
    text-decoration: none;
    text-decoration-color: var(--c-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .services__addons li a:hover {
    text-decoration-line: underline;
  }

  .services__addons li::before {
    content: '';
    flex-shrink: 0;
    width: 0.3rem;
    height: 0.3rem;
    border: 1px solid var(--c-gold);
    transform: rotate(45deg);
  }

  .services__addons .text-link {
    justify-self: start;
  }
</style>
