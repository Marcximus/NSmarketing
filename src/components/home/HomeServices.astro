---
// De fire kerneydelser som typografisk liste med hårstreger (.ruled-list) + udvalgte tillægsydelser
// (linker til kortene på pakkesiden). Ingen numre, ikoner eller kort – overskrifterne bærer sig selv.
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { services } from '../../data/content';
import { addonCategories } from '../../data/addons';

// Udvalgte tillæg, som vises som "Og når I vil mere"
const featuredAddonIds = ['statister', 'email', 'seo', 'influencer', 'video', 'meta-ads'];
const allAddons = addonCategories.flatMap((c) => c.items);
const featuredAddons = featuredAddonIds
  .map((id) => allAddons.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// Blød bindestreg i lange sammensatte ord ("Influencer-/marketing"), så de kan brydes i de smalle mobilkolonner
const breakable = (name: string) => name.replace(/(\p{Ll})(marketing)/gu, '$1\u00AD$2');
---

<section class="section section--white services">
  <div class="container">
    <SectionHead
      title="Alt, hvad jeres sociale medier kræver"
      lead="Fire discipliner, ét samlet team og én fast pris om måneden. Vi tager ansvaret for hele processen – fra den første strategi til den månedlige rapport."
      align="split"
    />

    <ul class="ruled-list ruled-list--2 services__list" role="list">
      {
        services.map((s) => (
          <li>
            <h3 class="ruled-list__title">{s.title}</h3>
            <p class="ruled-list__text">{s.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="services__addons">
      <p class="services__addons-label">Og når I vil mere</p>
      <ul>
        {featuredAddons.map((a) => (
          <li>
            <a href={`/pakkeloesninger/#tillaeg-${a.id}`}>{breakable(a.name)}</a>
          </li>
        ))}
      </ul>
      <a href="/pakkeloesninger/#tillaeg" class="text-link">Alle tillægsydelser <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  /* Tillæg */
  .services__addons {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  @media (min-width: 1024px) {
    .services__addons {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2.5rem;
      margin-top: 2.25rem;
    }
  }

  .services__addons-label {
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  .services__addons ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.5rem;
    list-style: none;
  }

  @media (min-width: 720px) {
    .services__addons ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.75rem; /* linkene er selv 44 px høje */
    }
  }

  .services__addons li {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--f-serif);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--c-ink);
  }

  .services__addons li a {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    overflow-wrap: anywhere;
    color: inherit;
    text-decoration: none;
    text-decoration-color: var(--c-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  @media (hover: hover) {
    .services__addons li a:hover {
      text-decoration-line: underline;
    }
  }

  .services__addons li::before {
    content: '';
    flex-shrink: 0;
    width: 0.3rem;
    height: 0.3rem;
    border: 1px solid var(--c-gold);
    transform: rotate(45deg);
  }

  .services__addons .text-link {
    justify-self: start;
  }
</style>
