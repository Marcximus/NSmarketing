---
// Forsidens fuldskærms-hero med billede, mørkebrun gradient og overlay-header.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { IconName } from '../../data/icons';
import heroImage from '../../assets/images/hero.jpg';
import { packages, comparison, formatPrice } from '../../data/packages';

const fromPrice = formatPrice(Math.min(...packages.map((p) => p.price)));

// Kanalerne hentes fra sammenligningstabellen, så de altid matcher pakkerne
const channels = (comparison.find((g) => g.title === 'Kanaler')?.rows ?? []).map((r) => ({
  label: r.label,
  icon: r.label.toLowerCase() as IconName,
}));
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title" class="display hero__title">
        Sociale medier, der sætter jeres brand i <em>scene</em>
      </h1>
      <p class="lead hero__lead">
        Strategi, content, annoncering og rapportering – samlet i én fast månedlig pakke og håndteret af
        ét&nbsp;team.
      </p>
      <div class="btn-row hero__actions">
        <a href="/pakkeloesninger/" class="btn btn--gold">Se pakkerne <Icon name="arrow" size={16} /></a>
        <a href="/kontakt/" class="btn btn--outline-light">Book et uforpligtende møde</a>
      </div>
      <p class="hero__price">
        <span class="hero__price-rule" aria-hidden="true"></span>
        <span>Pakker fra <strong>{fromPrice}&nbsp;kr./md.</strong> ekskl. moms</span>
      </p>
    </div>
  </div>

  <div class="container">
    <div class="hero__bottom">
      <div class="hero__channels">
        <p class="hero__channels-label" id="hero-channels">Vi arbejder på</p>
        <ul aria-labelledby="hero-channels">
          {
            channels.map((c) => (
              <li>
                <Icon name={c.icon} size={15} />
                <span>{c.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <a href="#intro" class="hero__scroll">
        <span>Udforsk</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-line: rgb(var(--c-cream-rgb) / 0.22);

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: max(88vh, 640px);
    min-height: max(88svh, 640px);
    padding-top: var(--header-h);
    overflow: hidden;
    background: var(--c-brown-deep);
    color: var(--c-cream);
  }

  /* Billede */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: hero-zoom 1.8s var(--ease-out-expo) both;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }

  /* Mørkebrun gradient: tættest bag teksten og i bunden */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgb(var(--c-brown-deep-rgb) / 0.72) 0%,
        transparent 28%
      ),
      linear-gradient(
        0deg,
        rgb(var(--c-brown-deep-rgb) / 0.92) 0%,
        rgb(var(--c-brown-deep-rgb) / 0.4) 42%,
        transparent 70%
      ),
      linear-gradient(
        90deg,
        rgb(var(--c-brown-deep-rgb) / 0.88) 0%,
        rgb(var(--c-brown-deep-rgb) / 0.72) 45%,
        rgb(var(--c-brown-rgb) / 0.38) 100%
      );
  }

  /* Indhold */
  .hero__inner {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 9vh, 7rem) clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero__content {
    max-width: 50rem;
  }

  /* Høje, smalle skærme (tablet på højkant): teksten forankres i bunden som et editorial-cover */
  @media (max-width: 1023px) and (min-aspect-ratio: 1/2) and (max-aspect-ratio: 4/5) {
    .hero__inner {
      align-items: flex-end;
    }
  }

  /* Sitets ene forfattede øjeblik: H1 afdækkes nedefra som et tæppe, der går op.
     backwards (ikke both), så clip-path ikke bliver hængende og klipper descendere bagefter. */
  .hero__title {
    max-width: 15ch;
    color: var(--c-cream);
    animation: hero-curtain 1.3s var(--ease-out-expo) 0.15s backwards;
  }

  /* Sitets eneste kursive overskriftsord – global.css neutraliserer ellers em i overskrifter */
  .hero__title em {
    font-style: italic;
    color: var(--c-gold-light);
  }

  @keyframes hero-curtain {
    from {
      clip-path: inset(100% 0 0 0);
      transform: translateY(0.25em);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  .hero__lead {
    max-width: 36rem;
    margin-top: var(--space-6);
    color: var(--c-cream-muted);
  }

  .hero__actions {
    margin-top: var(--space-7);
  }

  .hero__price {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-variant-numeric: lining-nums;
    margin-top: var(--space-6);
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--c-cream-muted);
  }

  .hero__price strong {
    font-weight: 500;
    color: var(--c-cream);
  }

  .hero__price-rule {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1px;
    background: var(--c-gold-light);
  }

  /* Bundlinje: kanaler + scroll */
  .hero__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--hero-line);
  }

  .hero__channels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
  }

  .hero__channels-label {
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-light);
  }

  .hero__channels ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    list-style: none;
  }

  .hero__channels li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--c-cream);
  }

  .hero__channels li :global(svg) {
    color: var(--c-gold-light);
  }

  .hero__scroll {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__scroll {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      min-height: 44px;
      font-size: var(--fs-2xs);
      font-weight: 500;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      text-decoration: none;
      color: var(--c-cream);
    }

    .hero__scroll:hover {
      color: var(--c-gold-light);
    }

  }

  .hero__scroll-line {
    width: 3.5rem;
    height: 1px;
    background: var(--hero-line);
  }

  /* Mobil: kraftigere overlay, da teksten fylder hele bredden */
  @media (max-width: 719px) {
    .hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgb(var(--c-brown-deep-rgb) / 0.7) 0%,
          rgb(var(--c-brown-deep-rgb) / 0.62) 40%,
          rgb(var(--c-brown-deep-rgb) / 0.94) 100%
        );
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__channels {
      gap: 0.75rem;
    }
  }

  /* Lav desktop/laptop (fx 1280×720): mindre H1 og luft, så prislinjen og kanalbåndet står over folden */
  @media (min-width: 1024px) and (max-height: 820px) {
    .hero__title {
      font-size: clamp(2.75rem, 1rem + 7vh, 4.25rem);
    }

    .hero__inner {
      padding-block: 2rem 2.5rem;
    }
  }

  /* Telefon på tværs: begge knapper synlige uden scroll */
  @media (orientation: landscape) and (max-height: 500px) {
    .hero {
      min-height: auto;
    }

    .hero__inner {
      padding-block: 1.25rem 1.75rem;
    }

    .hero__title {
      font-size: 2.25rem;
      max-width: 24ch;
    }

    .hero__lead {
      margin-top: 0.75rem;
    }

    .hero__actions {
      margin-top: 1.25rem;
    }

    .hero__actions .btn {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img,
    .hero__title {
      animation: none;
    }
  }
</style>
