---
// Forsidens fuldskærms-hero med billede, mørkebrun gradient og overlay-header.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { IconName } from '../../data/icons';
import heroImage from '../../assets/images/hero.jpg';
import { packages, comparison, formatPrice } from '../../data/packages';

const fromPrice = formatPrice(Math.min(...packages.map((p) => p.price)));

// Kanalerne hentes fra sammenligningstabellen, så de altid matcher pakkerne
const channels = (comparison.find((g) => g.title === 'Kanaler')?.rows ?? []).map((r) => ({
  label: r.label,
  icon: r.label.toLowerCase() as IconName,
}));
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__in" style="--in-delay: .1s">Social media management</p>
      <h1 id="hero-title" class="display hero__title hero__in" style="--in-delay: .2s">
        Sociale medier, der sætter jeres brand i <em>scene</em>
      </h1>
      <p class="lead hero__lead hero__in" style="--in-delay: .35s">
        Få jeres egen Social Media Manager – og et helt team bag. Strategi, content, annoncering og
        rapportering samlet i én fast månedlig pakke.
      </p>
      <div class="btn-row hero__actions hero__in" style="--in-delay: .5s">
        <a href="/pakkeloesninger/" class="btn btn--gold">Se pakkerne <Icon name="arrow" size={16} /></a>
        <a href="/kontakt/" class="btn btn--outline-light">Book et uforpligtende møde</a>
      </div>
      <p class="hero__price hero__in" style="--in-delay: .6s">
        <span class="hero__price-rule" aria-hidden="true"></span>
        <span>Pakker fra <strong>{fromPrice}&nbsp;kr./md.</strong> ekskl. moms</span>
      </p>
    </div>
  </div>

  <div class="container hero__in" style="--in-delay: .75s">
    <div class="hero__bottom">
      <div class="hero__channels">
        <p class="hero__channels-label" id="hero-channels">Vi arbejder på</p>
        <ul aria-labelledby="hero-channels">
          {
            channels.map((c) => (
              <li>
                <Icon name={c.icon} size={15} />
                <span>{c.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <a href="#intro" class="hero__scroll">
        <span>Udforsk</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-line: color-mix(in srgb, var(--c-cream) 22%, transparent);

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: max(88vh, 640px);
    min-height: max(88svh, 640px);
    padding-top: var(--header-h);
    overflow: hidden;
    background: var(--c-brown-deep);
    color: var(--c-cream);
  }

  /* Billede */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: hero-zoom 2.6s var(--ease) both;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }

  /* Mørkebrun gradient: tættest bag teksten og i bunden */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--c-brown-deep) 72%, transparent) 0%,
        transparent 28%
      ),
      linear-gradient(
        0deg,
        color-mix(in srgb, var(--c-brown-deep) 92%, transparent) 0%,
        color-mix(in srgb, var(--c-brown-deep) 40%, transparent) 42%,
        transparent 70%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--c-brown-deep) 88%, transparent) 0%,
        color-mix(in srgb, var(--c-brown-deep) 72%, transparent) 45%,
        color-mix(in srgb, var(--c-brown) 38%, transparent) 100%
      );
  }

  /* Indhold */
  .hero__inner {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 9vh, 7rem) clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero__content {
    max-width: 50rem;
  }

  /* Høje, smalle skærme (tablet på højkant): teksten forankres i bunden som et editorial-cover */
  @media (max-width: 1023px) and (min-aspect-ratio: 1/2) and (max-aspect-ratio: 4/5) {
    .hero__inner {
      align-items: flex-end;
    }
  }

  .hero__title {
    max-width: 13.5ch;
    font-size: clamp(2.75rem, 1.2rem + 5.2vw, 5.75rem);
    color: var(--c-cream);
  }

  .hero__lead {
    max-width: 36rem;
    margin-top: var(--space-6);
    color: var(--c-cream-muted);
  }

  .hero__actions {
    margin-top: var(--space-7);
  }

  .hero__price {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-variant-numeric: lining-nums;
    margin-top: var(--space-6);
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--c-cream-muted);
  }

  .hero__price strong {
    font-weight: 500;
    color: var(--c-cream);
  }

  .hero__price-rule {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1px;
    background: var(--c-gold-light);
  }

  /* Bundlinje: kanaler + scroll */
  .hero__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--hero-line);
  }

  .hero__channels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
  }

  .hero__channels-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-light);
  }

  .hero__channels ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    list-style: none;
  }

  .hero__channels li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--c-cream);
  }

  .hero__channels li :global(svg) {
    color: var(--c-gold-light);
  }

  .hero__scroll {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__scroll {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      min-height: 44px;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      text-decoration: none;
      color: var(--c-cream);
    }

    .hero__scroll:hover {
      color: var(--c-gold-light);
    }

  }

  .hero__scroll-line {
    position: relative;
    width: 3.5rem;
    height: 1px;
    overflow: hidden;
    background: var(--hero-line);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-gold-light);
    transform: translateX(-100%);
    animation: hero-line 2.4s var(--ease) 1.2s infinite;
  }

  @keyframes hero-line {
    0% {
      transform: translateX(-100%);
    }
    55% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* Indgangsanimation (uden JS – slås fra ved reduced motion i global.css) */
  .hero__in {
    animation: hero-in 1.1s var(--ease) both;
    animation-delay: var(--in-delay, 0s);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Mobil: kraftigere overlay, da teksten fylder hele bredden */
  @media (max-width: 719px) {
    .hero__overlay {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--c-brown-deep) 70%, transparent) 0%,
          color-mix(in srgb, var(--c-brown-deep) 62%, transparent) 40%,
          color-mix(in srgb, var(--c-brown-deep) 94%, transparent) 100%
        );
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__channels {
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img,
    .hero__scroll-line::after {
      animation: none;
    }

    .hero__scroll-line::after {
      transform: none;
    }
  }
</style>
