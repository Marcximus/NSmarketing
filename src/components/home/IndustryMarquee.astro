---
// Diskret, langsomt glidende bånd med de brancher, vi arbejder med.
// Stopper ved prefers-reduced-motion og kan sættes på pause (WCAG 2.2.2).
import { industries } from '../../data/content';
---

<section class="marquee" aria-labelledby="marquee-label" data-marquee>
  <div class="marquee__inner">
    <p class="marquee__label" id="marquee-label">Vi skaber indhold til</p>
    <div class="marquee__viewport">
      <div class="marquee__track">
        <ul class="marquee__list">
          {industries.map((item) => <li>{item}</li>)}
        </ul>
        <ul class="marquee__list marquee__list--clone" aria-hidden="true">
          {industries.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
    <button class="marquee__toggle" type="button" aria-pressed="false" data-marquee-toggle>
      <span class="visually-hidden">Pause det glidende bånd</span>
      <span class="marquee__icon" aria-hidden="true"></span>
    </button>
  </div>
</section>

<style>
  .marquee {
    --marquee-duration: 55s;

    background: var(--c-white);
    border-block: 1px solid var(--c-line);
  }

  .marquee__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    padding-left: var(--gutter);
  }

  .marquee__label {
    grid-column: 1 / -1;
    padding-top: 1.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }

  @media (min-width: 900px) {
    .marquee__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .marquee__label {
      grid-column: auto;
      padding: 0 2rem 0 0;
      margin-right: 0.5rem;
      border-right: 1px solid var(--c-line);
      line-height: 4.5rem;
    }
  }

  .marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee__list {
    display: flex;
    flex-shrink: 0;
    list-style: none;
  }

  .marquee__list li {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    padding-right: clamp(1.75rem, 3vw, 2.75rem);
    padding-block: 1.1rem 1.35rem;
    font-family: var(--f-serif);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    font-style: italic;
    white-space: nowrap;
    color: var(--c-ink);
  }

  .marquee__list li::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--c-gold);
    transform: rotate(45deg);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee:hover .marquee__track,
  .marquee.is-paused .marquee__track {
    animation-play-state: paused;
  }

  /* Pause-knap */
  .marquee__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-inline: 0.5rem var(--gutter);
    border: 1px solid var(--c-line);
    color: var(--c-ink-2);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .marquee__toggle:hover {
    border-color: var(--c-ink);
    color: var(--c-ink);
  }

  /* Uden JS virker knappen ikke – skjul den (hover-pausen virker stadig) */
  :global(html:not(.js)) .marquee__toggle {
    display: none;
  }

  /* Pause-ikon (to streger) → afspil-ikon (trekant) */
  .marquee__icon {
    width: 8px;
    height: 10px;
    border-inline: 1.5px solid currentColor;
  }

  .marquee.is-paused .marquee__icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent currentColor;
  }

  /* Reduceret bevægelse: statisk liste, ingen dublet */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      width: auto;
      animation: none;
    }

    .marquee__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee__list {
      flex-wrap: wrap;
      flex-shrink: 1;
    }

    .marquee__list--clone,
    .marquee__toggle {
      display: none;
    }

    .marquee__list li {
      gap: 0.9rem;
      padding-block: 0.3rem;
      padding-right: 0.9rem;
      font-size: 1.1rem;
    }

    .marquee__inner {
      padding-block: 0.6rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
    toggle?.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
    });
  });
</script>
