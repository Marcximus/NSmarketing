---
// Arbejdsprocessen i fire trin på diskret marmorbaggrund.
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { process } from '../../data/content';
---

<section class="section process">
  <div class="process__bg" aria-hidden="true"></div>
  <div class="container">
    <SectionHead
      eyebrow="Sådan arbejder vi"
      title="Fra første møde til <em>målbare</em> resultater"
      lead="En fast og gennemskuelig proces, så I altid ved, hvad der sker – og hvornår. I godkender, vi leverer."
      align="split"
    />

    <ol class="steps">
      {
        process.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
            <span class="step__num" aria-hidden="true">
              {step.number}
            </span>
            <span class="step__line" aria-hidden="true" />
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="process__cta" data-reveal>
      <p>Det hele begynder med et uforpligtende møde.</p>
      <a href="/kontakt/" class="text-link">Book et møde <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .process {
    isolation: isolate;
    overflow: hidden;
    background: var(--c-paper);
  }

  .process__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--c-paper) 55%, transparent) 0%,
        color-mix(in srgb, var(--c-paper) 78%, transparent) 100%
      ),
      url('../../assets/images/marble.jpg');
    background-size: cover;
    background-position: center;
  }

  .steps {
    display: grid;
    gap: 2.75rem;
    list-style: none;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
  }

  .step__num {
    display: block;
    font-family: var(--f-serif);
    font-variant-numeric: lining-nums;
    font-size: clamp(3rem, 2.4rem + 1.8vw, 4.25rem);
    font-style: italic;
    line-height: 1;
    color: var(--c-gold-ink);
  }

  /* Hårstreg med lille guld-rude */
  .step__line {
    position: relative;
    display: block;
    height: 1px;
    margin-block: 1.5rem 1.75rem;
    background: var(--c-sand);
  }

  .step__line::before {
    content: '';
    position: absolute;
    top: -3.5px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--c-gold);
    transform: rotate(45deg);
  }

  .step__title {
    font-size: clamp(1.3rem, 1.15rem + 0.4vw, 1.5rem);
  }

  .step__text {
    margin-top: var(--space-3);
    max-width: 22rem;
    font-size: 0.975rem;
    color: var(--c-ink-2);
  }

  .process__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--c-sand);
  }

  .process__cta p {
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    color: var(--c-ink);
  }
</style>
