---
// Kundeudtalelser i redaktionelt layout på mørk marmor (delt .marble--dark): fast (sticky) overskrift
// til venstre, ét stort citat og resten i en række til højre. id="udtalelser" er mål for links fra forsiden.
// OBS: Indholdet kommer fra content.ts og er pt. eksempler (placeholder: true), der skal udskiftes.
// Så længe en udtalelse er markeret placeholder, vises den som "Eksempel på udtalelse" i stedet for
// navn og virksomhed – fiktive citater må ikke fremstå som rigtige kunders ord (markedsføringsloven).
import Icon from '../Icon.astro';
import { testimonials } from '../../data/content';

const [feature, ...rest] = testimonials;
---

{
  feature && (
    <section class="section section--deep case-quotes" id="udtalelser" aria-labelledby="case-quotes-title">
      <div class="marble marble--dark" aria-hidden="true" />
      <div class="container case-quotes__layout">
        <div class="case-quotes__head">
          <h2 id="case-quotes-title">Ord fra dem, vi arbejder for</h2>
        </div>

        <div class="case-quotes__body">
          <figure class="case-quotes__feature">
            <Icon name="quote" size={44} strokeWidth={0.9} class="case-quotes__mark" />
            <blockquote>
              <p>{feature.quote}</p>
            </blockquote>
            <figcaption>
              {feature.placeholder ? (
                <span class="case-quotes__example">Eksempel på udtalelse</span>
              ) : (
                <>
                  <span class="case-quotes__name">{feature.name}</span>
                  <span class="case-quotes__company">{feature.company}</span>
                </>
              )}
            </figcaption>
          </figure>

          {rest.length > 0 && (
            <ul class="case-quotes__list" role="list">
              {rest.map((t) => (
                <li>
                  <figure class="case-quotes__item">
                    <blockquote>
                      <p>{t.quote}</p>
                    </blockquote>
                    <figcaption>
                      {t.placeholder ? (
                        <span class="case-quotes__example">Eksempel på udtalelse</span>
                      ) : (
                        <>
                          <span class="case-quotes__name">{t.name}</span>
                          <span class="case-quotes__company">{t.company}</span>
                        </>
                      )}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Forælder til den delte .marble--dark. overflow: clip (ikke hidden), så den sticky overskrift
     stadig følger med – clip opretter ingen scroll-container. */
  .case-quotes {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
  }

  .case-quotes__layout {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .case-quotes__head h2 {
    max-width: 12ch;
  }

  .case-quotes__feature :global(.case-quotes__mark) {
    color: var(--c-gold);
    margin-bottom: 1.75rem;
  }

  .case-quotes blockquote {
    margin: 0;
  }

  .case-quotes__feature blockquote p {
    font-family: var(--f-serif);
    font-size: clamp(1.5rem, 1rem + 1.7vw, 2.25rem);
    font-style: italic;
    line-height: 1.42;
    letter-spacing: -0.01em;
    color: var(--c-cream);
  }

  .case-quotes figcaption {
    display: grid;
    gap: 0.25rem;
    width: fit-content;
    min-width: 3rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-gold);
  }

  .case-quotes__name {
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-cream);
  }

  .case-quotes__company {
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-cream-muted);
  }

  .case-quotes__example {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-cream-muted);
  }

  .case-quotes__list {
    display: grid;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    list-style: none;
    border-top: 1px solid rgb(var(--c-cream-muted-rgb) / 0.3);
  }

  .case-quotes__item {
    padding-block: 2rem;
  }

  .case-quotes__list > li + li .case-quotes__item {
    border-top: 1px solid rgb(var(--c-cream-muted-rgb) / 0.3);
  }

  .case-quotes__item blockquote p {
    font-family: var(--f-serif);
    font-size: clamp(1.0625rem, 1.02rem + 0.3vw, 1.25rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--c-cream);
  }

  .case-quotes__item figcaption {
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .case-quotes__layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }

    /* Overskriften følger med, mens man læser citaterne */
    .case-quotes__head {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }

    .case-quotes__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-quotes__item {
      padding: 2.5rem 2.5rem 0 0;
    }

    .case-quotes__list > li + li .case-quotes__item {
      height: 100%;
      border-top: 0;
      padding-left: 2.5rem;
      padding-right: 0;
      border-left: 1px solid rgb(var(--c-cream-muted-rgb) / 0.3);
    }
  }
</style>
