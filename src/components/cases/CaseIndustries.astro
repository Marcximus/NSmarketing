---
// Brancher vi arbejder med – statisk, redaktionel liste med hårstreger (delt .ruled-list) på papir.
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { industries } from '../../data/content';
---

<section class="section case-industries">
  <div class="container">
    <SectionHead
      title="Brancher, vi arbejder med"
      lead="Hver branche har sine egne kunder, sæsoner og spilleregler. Vi sætter os grundigt ind i jeres – og skaber indhold, der taler direkte til de mennesker, I gerne vil nå."
      align="split"
    />

    <ul class="ruled-list ruled-list--2 industries" role="list">
      {
        industries.map((name) => (
          <li>
            <span class="industries__name">{name}</span>
          </li>
        ))
      }
    </ul>

    <div class="case-industries__note">
      <p>Er jeres branche ikke på listen? Vi tager gerne en snak om, hvad vi kan gøre for jer.</p>
      <a href="/kontakt/" class="text-link">Fortæl os om jeres virksomhed <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .case-industries {
    background: var(--c-paper);
    border-top: 1px solid var(--c-line);
  }

  .industries > li {
    padding-block: 1rem;
  }

  .industries__name {
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    line-height: 1.3;
  }

  @media (min-width: 1100px) {
    .industries {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .case-industries__note {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .case-industries__note p {
    color: var(--c-ink-2);
  }

  @media (min-width: 900px) {
    .case-industries__note {
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
