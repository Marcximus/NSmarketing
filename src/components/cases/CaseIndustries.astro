---
// Brancher vi arbejder med – skarpt grid med hårstreger på lys marmor.
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { industries } from '../../data/content';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section case-industries">
  <div class="case-industries__bg" aria-hidden="true"></div>
  <div class="container">
    <SectionHead
      eyebrow="Brancher"
      title="Brancher, vi <em>arbejder</em> med"
      lead="Hver branche har sine egne kunder, sæsoner og spilleregler. Vi sætter os grundigt ind i jeres – og skaber indhold, der taler direkte til de mennesker, I gerne vil nå."
      align="split"
    />

    <ul class="industries" role="list">
      {
        industries.map((name, i) => (
          <li class="industry" data-reveal style={`--reveal-delay: ${(i % 4) * 0.06}s`}>
            <span class="industry__num" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span class="industry__name">{name}</span>
          </li>
        ))
      }
    </ul>

    <div class="case-industries__note" data-reveal>
      <p>Er jeres branche ikke på listen? Vi tager gerne en snak om, hvad vi kan gøre for jer.</p>
      <a href="/kontakt/" class="text-link">Fortæl os om jeres virksomhed <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .case-industries {
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--c-line);
  }

  .case-industries__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--c-paper) 90%, transparent) 0%,
        color-mix(in srgb, var(--c-paper) 78%, transparent) 100%
      ),
      url('../../assets/images/marble.jpg');
    background-size: cover;
    background-position: center 70%;
  }

  .industries {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    border-top: 1px solid var(--c-sand);
  }

  .industry {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--c-sand);
  }

  .industry__num {
    flex-shrink: 0;
    width: 1.75rem;
    font-family: var(--f-serif);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--c-gold-ink);
  }

  .industry__name {
    font-family: var(--f-serif);
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    line-height: 1.3;
  }

  @media (min-width: 600px) {
    .industries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: 1px solid var(--c-sand);
    }

    .industry {
      flex-direction: column;
      justify-content: space-between;
      gap: 2.5rem;
      min-height: 9.5rem;
      padding: 1.5rem 1.5rem 1.6rem;
      border-right: 1px solid var(--c-sand);
      background: color-mix(in srgb, var(--c-white) 55%, transparent);
    }

    .industry__name {
      position: relative;
      padding-top: 1rem;
    }

    .industry__name::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 1.5rem;
      height: 1px;
      background: var(--c-gold);
    }
  }

  @media (min-width: 1024px) {
    .industries {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .industry {
      min-height: 11.5rem;
      padding: 1.75rem 1.75rem 1.9rem;
    }
  }

  .case-industries__note {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .case-industries__note p {
    color: var(--c-ink-2);
  }

  @media (min-width: 900px) {
    .case-industries__note {
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
