# Kun relevant på Apache-webhoteller (fx Simply.com/one.com)
ErrorDocument 404 /404.html

# Filer i /_astro/ har hash i navnet og ændrer sig aldrig – cache dem i et år
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
